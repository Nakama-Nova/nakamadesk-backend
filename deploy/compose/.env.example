# Copy to .env (same folder) and fill in. .env is ignored by git; never commit it.

# Your API domain. Its DNS A record must point at this VM first. Use :80 for local tests.
SITE_ADDRESS=api.example.com

# Letters and digits only (it is placed inside a URL). Make one with: openssl rand -hex 24
POSTGRES_PASSWORD=
# At least 32 characters; the app refuses to start otherwise. openssl rand -hex 32
SECRET_KEY=

# The storefront origins allowed to call the API from a browser, comma separated.
CORS_ORIGINS=
DELIVERY_PINCODES=

# Private file store for scans and models (optional). Cloudflare R2 works.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email for customer sign-in codes (an SMTP account from SES, Brevo, Resend...).
# Leave SMTP_HOST empty in production and "send me a code" answers 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Codes and order updates are sent from notifications@; replies go to info@.
EMAIL_FROM=Vriksha Studios <notifications@vrikshastudios.com>
EMAIL_REPLY_TO=info@vrikshastudios.com

# Paying by cash or UPI. Shoppers order on the website, staff confirm by phone, then
# they pay cash or UPI. PAY_UPI_ID shows a pay link on confirmed orders (leave empty to
# show none). PAY_PHONE is the number shoppers are told to call.
PAY_UPI_ID=
PAY_UPI_NAME=Vriksha Studios
PAY_PHONE=

# Desktop app updates (optional).
GITHUB_RELEASES_TOKEN=

# Backups. Use a separate R2 bucket and a token that can only write to it.
# BACKUP_REMOTE is "backup:<bucket name>". S3_ENDPOINT_URL above is reused as the R2 endpoint.
BACKUP_REMOTE=backup:nakama-backups
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_KEEP_DAYS=30
# Optional: a healthchecks.io (or similar) URL pinged after each good backup.
BACKUP_PING_URL=

# Which image to run. Leave as is; set to a git sha to keep a rollback point.
API_TAG=local
