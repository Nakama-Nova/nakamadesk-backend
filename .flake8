[flake8]
max-line-length = 127
exclude = .git,__pycache__,docs/source/conf.py,old,build,dist,venv,.venv
# F401: imported but unused (common in __init__.py)
# E402: module level import not at top of file
# C901: complex function
per-file-ignores =
    app/models/__init__.py: F401
    app/api/dashboard.py: E402
    app/api/invoices.py: E402
    app/api/sales.py: E402
    app/services/analytics_service.py: E402
    app/services/sync_service.py: E402
    tests/conftest.py: E402
    tests/test_edge_cases.py: E402
